# Keep build context small for the ping_probe Dockerfile.
# Same exclusions as Dockerfile.dockerignore.

# Build outputs
build/
cov/
cmake-build-debug/
cmake-build-release/
build-*/
cmake-build-*/

# Version control
.git/
.gitignore

# Superpowers / internal docs
.superpowers/

# Test artifacts
tests/
benchmark/
bench/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# CI
.woodpecker/

# Docs
docs/
README.md
CLAUDE.md

# Scripts

# Cluster keys / generated passwords of the authentication e2e
docker/secrets/
docker/.auth.*/

# Launchers, compose files, docs of the e2e: they drive docker from outside and are not needed inside the build
# (keeping them out of the context keeps the compiled layers cached when only a launcher changes)
docker/*.sh
!docker/entrypoint.sh
docker/lib/
docker/topics/
docker/*.yml
docker/README.md
docker/rune-cluster.env.example
dr-e2e/
