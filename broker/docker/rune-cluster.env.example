# rune-cluster.env.example — tunables for docker-compose.custom.yml
# Copy to `rune-cluster.env` and edit, then:
#   docker compose --env-file docker/rune-cluster.env -f docker/docker-compose.custom.yml up -d
#
# NOTE: RUNE_CLIENT_ENDPOINT and the host:port entries in RUNE_PEERS are RAW host:port
#       — the broker prepends "aeron:udp?endpoint=". Do NOT pass a full "aeron:udp?..." string.

# ── Authentication (ON by default) ───────────────────────────────────────────
# Every node mounts the SAME cluster key file, read-only, at /run/secrets/cluster.key; the broker refuses to start
# without it.  Make one once:   rune security gen-cluster-key --out docker/secrets/cluster.key
# Then bootstrap the first admin (docs/SECURITY.md):
#   rune security bootstrap --admin admin --cluster-key-file docker/secrets/cluster.key --broker <host>:<CLIENT_HOST_PORT_1>
# The path is relative to docker-compose.custom.yml's directory (docker/) unless absolute.  The file must not be
# group- or world-accessible (chmod 0600).
CLUSTER_KEY_FILE=./secrets/cluster.key

# ── Image ────────────────────────────────────────────────────────────────────
RUNE_IMAGE=rune:latest

# ── Ports (same on every node; each node is its own container) ────────────────
CONSENSUS_PORT=40111        # inter-node consensus (aeron:udp)
CLIENT_PORT=40200           # client gateway (aeron:udp)

# ── Host-published client UDP ports (so clients OUTSIDE docker can connect) ────
# One distinct host port per node → the in-container CLIENT_PORT.
CLIENT_HOST_PORT_1=40201
CLIENT_HOST_PORT_2=40202
CLIENT_HOST_PORT_3=40203

# ── Data dirs on the HOST (bind-mounted; survive `down`, you control location) ─
DATA_DIR_1=./rune-data/node0
DATA_DIR_2=./rune-data/node1
DATA_DIR_3=./rune-data/node2

# ── Storage format (read only for an EMPTY data dir) ──────────────────────────
# Empty (default): the broker refuses to start on an empty data dir and tells you what to run.
# First start of a NEW cluster: format each node once, then leave this empty:
#   docker compose ... run --rm rune-1 rune_broker storage format --new
# Keeping RUNE_STORAGE_FORMAT=join is safe on a multi-node cluster (a replaced disk rejoins).
RUNE_STORAGE_FORMAT=

# ── Shared-memory size for the embedded Aeron media driver (min ~256m) ────────
SHM_SIZE=256m

# ── Aeron stream ids (rarely changed) ─────────────────────────────────────────
RUNE_CLIENT_STREAM_ID=1
RUNE_CONSENSUS_STREAM_ID=10

# ── Election timing (raise for slow / cross-datacenter networks) ──────────────
RUNE_ELECTION_TIMEOUT_MS=300
RUNE_ELECTION_STATUS_INTERVAL_MS=50
RUNE_STARTUP_CANVASS_TIMEOUT_MS=200
