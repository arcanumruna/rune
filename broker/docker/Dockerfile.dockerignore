# Keep build context small — exclude everything that is not needed to build
# the rune_broker binary.

# Build outputs
build/
cov/
cmake-build-debug/
cmake-build-release/
build-*/
cmake-build-*/

# Version control
.git/
.gitignore

# Superpowers / internal docs
.superpowers/

# Test artifacts
tests/
benchmark/
bench/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# CI (not needed inside the container)
.woodpecker/

# Docs (not needed in builder)
docs/
README.md
CLAUDE.md

# Scripts that drive docker (not needed inside)
build_docker.sh
