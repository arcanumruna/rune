# Per-Dockerfile ignore for Dockerfile.data (rune_produce_subscribe E2E example).
# Keep build context small + exclude the host build trees (a leaked host
# CMakeCache.txt breaks the in-image cmake configure).

# Build outputs (large; a leaked host build/ CMakeCache aborts the container build)
build/
build_release/
build_tsan/
build_asan/
cov/
cmake-build-debug/
cmake-build-release/
conan-release/

# Version control
.git/
.gitignore

# Superpowers / internal docs
.superpowers/

# Tests and benchmarks (not built in the data example image)
# Tests (not built in this image) — EXCEPT the e2e probe source: configure
# (BUILD_EXAMPLES=ON) declares the EXCLUDE_FROM_ALL rune_ql_probe target and
# needs its source file to exist.
tests/*
!tests/e2e
tests/e2e/*
!tests/e2e/rune_ql_probe.cpp
benchmark/
bench/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# CI
.woodpecker/

# Docs
docs/
README.md
CLAUDE.md
