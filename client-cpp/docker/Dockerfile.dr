# syntax=docker/dockerfile:1
#
# rune-client-cpp — dr_client image (linux/amd64)
#
# DR-1 — configurable disaster-recovery driver for the rune-broker/dr-e2e
# pytest harness.  Builds the dr_client example (examples/dr_client.cpp).
#
# Build command (from rune-client-cpp repo root):
#   docker build --platform linux/amd64 \
#     --build-context rune-protocol=../rune-protocol \
#     --build-context rune-fr=../rune-fr \
#     --build-context rune-codec=../rune-codec \
#     --build-context rune-ql=../rune-ql \
#     --build-context rune-crypto=../rune-crypto \
#     -f docker/Dockerfile.dr \
#     -t rune-dr-client:$(git rev-parse --short HEAD) .   # always a git-SHA tag, never dev/latest
#
# The rune-protocol sibling repo is supplied via a BuildKit named build context.

# ── BUILDER ──────────────────────────────────────────────────────────────────
FROM gcc:13 AS builder

ARG CMAKE_VERSION=3.31.5
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv git curl ninja-build pkg-config \
        default-jdk-headless uuid-dev zlib1g-dev ccache \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir --break-system-packages "conan~=2.0"

ENV JAVA_HOME=/usr/lib/jvm/default-java

# ccache: compiler launcher for the app build (cache lives in a BuildKit cache mount, so it
# survives source edits).  Source path is always /build (+ fixed /rune-* siblings), so no
# CCACHE_BASEDIR is needed; COMPILERCHECK=content keys on the compiler binary, not mtime.
ENV CCACHE_DIR=/root/.ccache CCACHE_MAXSIZE=5G CCACHE_COMPILERCHECK=content

# Multi-arch (native arm64 on Apple Silicon Docker Desktop): pick the CMake build for the target arch.
RUN case "${TARGETARCH}" in arm64) CMAKE_ARCH=aarch64 ;; *) CMAKE_ARCH=x86_64 ;; esac \
    && curl -LO https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-${CMAKE_ARCH}.tar.gz \
    && tar -xzf cmake-${CMAKE_VERSION}-linux-${CMAKE_ARCH}.tar.gz --strip-components=1 -C /usr/local \
    && rm cmake-${CMAKE_VERSION}-linux-${CMAKE_ARCH}.tar.gz \
    && cmake --version

WORKDIR /build
RUN conan profile detect --force

# Conan install (cached independently of source edits).
COPY conanfile.py conandata.yml VERSION.txt ./
# The conan cache (/root/.conan2/p: packages + build dirs + sqlite db) is a BuildKit cache mount, so a
# conanfile change does not rebuild aeron from scratch.  Mount contents are NOT part of the layer, but
# conan-release/ (the generated toolchain) points into /root/.conan2/p/... -- so copy the cache into the
# layer at /opt/conan-p and symlink /root/.conan2/p to it in the next step.
# Requires BuildKit (--mount is a hard error on the legacy builder).
RUN --mount=type=cache,target=/root/.conan2/p,id=rune-conan-${TARGETARCH} \
    conan install . --output-folder=conan-release --build=missing -s build_type=Release \
    && cp -a /root/.conan2/p /opt/conan-p
RUN rmdir /root/.conan2/p && ln -s /opt/conan-p /root/.conan2/p

# rune-protocol sibling headers.
COPY --from=rune-protocol include /rune-protocol/include
# GSO-1 / A7: rune_gso + rune_client_driver_wake compile rune-protocol C sources (src/net).
COPY --from=rune-protocol src     /rune-protocol/src

# rune-fr flight recorder sibling (compiled: src + include).  The client's
# CMakeLists wires add_library(rune_fr ...) from ${SRC}/../rune-fr → /rune-fr from
# WORKDIR /build.  Supplied via the BuildKit named build context `rune-fr`:
#   docker build --build-context rune-fr=../rune-fr ...
COPY --from=rune-fr src     /rune-fr/src
COPY --from=rune-fr include /rune-fr/include

# rune-codec / rune-ql siblings: the client's CMakeLists always defines the
# rune_codec / rune_ql libraries (and, with BUILD_EXAMPLES, rune_codec_gen and
# the EXCLUDE_FROM_ALL rune_ql_probe), so configure needs their sources even
# though dr_client links neither.
COPY --from=rune-codec src     /rune-codec/src
COPY --from=rune-codec include /rune-codec/include
COPY --from=rune-codec tools   /rune-codec/tools
COPY --from=rune-ql src     /rune-ql/src
COPY --from=rune-ql include /rune-ql/include

# client<->broker TLS/AEAD (Task 5): rune-crypto sibling (TlsSession + AeadCipher +
# CPU cipher selection), compiled into rune_crypto by the client's CMakeLists.
# Supplied via the BuildKit named build context `rune-crypto`:
#   docker build --build-context rune-crypto=../rune-crypto ...
COPY --from=rune-crypto src     /rune-crypto/src
COPY --from=rune-crypto include /rune-crypto/include

# Application sources.
COPY . .

# Build dr_client only.
RUN --mount=type=cache,target=/root/.ccache,id=rune-ccache-${TARGETARCH} \
    --mount=type=cache,target=/build/build,id=rune-build-drclient-${TARGETARCH},sharing=locked \
    cmake -S . -B build -G Ninja \
        -DCMAKE_TOOLCHAIN_FILE=conan-release/build/Release/generators/conan_toolchain.cmake \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER_LAUNCHER=ccache \
        -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
        -DBUILD_TESTING=OFF \
        -DBUILD_BENCHMARKS=OFF \
        -DBUILD_EXAMPLES=ON \
        -DRUNE_PROTOCOL_INCLUDE=/rune-protocol/include \
        -DRUNE_CODEC_ROOT=/rune-codec \
        -DRUNE_QL_ROOT=/rune-ql \
        -DRUNE_FR_DIR=/rune-fr \
        -DRUNE_CRYPTO_ROOT=/rune-crypto \
    && cmake --build build --target dr_client -j2 \
    && mkdir -p /build/out && cp build/dr_client /build/out/ \
    && ccache -s

RUN cp -L /usr/local/lib64/libstdc++.so.6 /build/libstdc++.so.6

# ── RUNTIME ──────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        libstdc++6 \
        libgcc-s1 \
        libatomic1 \
        libuuid1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/out/dr_client /usr/local/bin/dr_client
# Multi-arch: the multiarch lib dir is x86_64-linux-gnu or aarch64-linux-gnu (= uname -m).
COPY --from=builder /build/libstdc++.so.6 /tmp/libstdc++.so.6.0.32
RUN mv /tmp/libstdc++.so.6.0.32 /usr/lib/$(uname -m)-linux-gnu/libstdc++.so.6.0.32 && ldconfig

# The client checkout this image was built from; the dr-e2e harness refuses an image whose label differs from the
# client HEAD (a stale image once ran against a current broker and failed produce with SchemaValidationFailed).
ARG RUNE_CLIENT_SHA=unknown
LABEL rune.client.sha=$RUNE_CLIENT_SHA

# Aeron embedded driver needs /dev/shm — use --shm-size=256m at runtime.
RUN mkdir -p /var/lib/rune-client
ENV RUNE_DATA_DIR=/var/lib/rune-client

ENTRYPOINT ["/usr/local/bin/dr_client"]
