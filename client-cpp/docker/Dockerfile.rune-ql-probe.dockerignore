# Per-Dockerfile ignore for Dockerfile.rune-ql-probe (Task 10, 0c #11 gate).
# Keep the build context small, but KEEP tests/e2e/ (characters.rql + the probe
# source rune_ql_probe.cpp) — the runtime CLI-driven compile needs both.

# Build outputs (large; do NOT send to the daemon)
build/
cov/
cmake-build-debug/
cmake-build-release/
conan-release/

# Version control
.git/
.gitignore

# Superpowers / internal docs
.superpowers/

# Benchmarks (not built in this image)
benchmark/
bench/

# Tests — exclude everything EXCEPT the e2e probe + schema.
tests/*
!tests/e2e
tests/e2e/*
!tests/e2e/rune_ql_probe.cpp
!tests/e2e/characters.rql
# Task 21 — real-Aeron schema-evolution e2e (docker/schema-evolution-e2e.sh,
# rune-broker repo): the evo_probe_vN sources + the .rql alter fixtures.
!tests/e2e/evo_probe_v1.cpp
!tests/e2e/evo_probe_v2.cpp
!tests/e2e/evo_probe_v3.cpp
!tests/e2e/evo_probe_v4.cpp
# GC7 — multi-producer-different-versions + long-lineage-reopen probe. This
# allowlist excludes tests/e2e/* by default, so a newly-added probe source must
# be re-included explicitly or `COPY . .` silently omits it from the context.
!tests/e2e/evo_probe_multi.cpp
!tests/e2e/schema_evolution

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# CI
.woodpecker/

# Docs
docs/
README.md
CLAUDE.md
