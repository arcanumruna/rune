# Per-Dockerfile ignore for Dockerfile.rune-ql-probe (Task 10, 0c #11 gate).
# Keep the build context small, but KEEP tests/e2e/ (characters.rql + the probe
# source rune_ql_probe.cpp) — the runtime CLI-driven compile needs both.

# Build outputs (large; do NOT send to the daemon)
build/
cov/
cmake-build-debug/
cmake-build-release/
conan-release/

# Version control
.git/
.gitignore

# Superpowers / internal docs
.superpowers/

# Benchmarks (not built in this image)
benchmark/
bench/

# Tests: keep tests/e2e/ and tests/generated/ WHOLE.  CMake configure (BUILD_EXAMPLES=ON) declares
# every EXCLUDE_FROM_ALL probe target (rune_ql_probe, evo_probe_v1..4, evo_probe_multi, ...) and
# needs their sources; a per-file allowlist goes stale whenever a probe is added (it did:
# evo_probe_multi.cpp, CMakeLists.txt:697).
tests/*
!tests/e2e
!tests/generated

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# CI
.woodpecker/

# Docs
docs/
README.md
CLAUDE.md
