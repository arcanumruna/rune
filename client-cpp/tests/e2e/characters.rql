-- tests/e2e/characters.rql — Task 10 (#11 real-e2e gate) checked-in Rune QL schema.
--
-- A single topic that INCLUDES a fixed-width string field (`code string(8)`) so
-- the single-node real-Aeron e2e exercises the FixedStr end-to-end path through
-- rune-codec-0c: parse -> serialize descriptor -> broker validate/readField ->
-- `rune schema generate` -> typed produce/consume -> decode -> assert code[8].
--
-- Consumed by docker/rune-ql-e2e.sh:
--   rune console -f    tests/e2e/characters.rql --broker <node> --validate
--   rune schema generate characters --out <gen> --broker <node>
--
-- Fields:
--   id      int64      — record identity
--   userId  int64      — partition key (see `key userId` below)
--   code    string(8)  — FIXED-width 8-byte string (FixedStr block field)
--   name    string     — variable-length string (var-len field)

topic characters {
    id     int64,
    userId int64,
    code   string(8),
    name   string
} partitions 1 key userId;
