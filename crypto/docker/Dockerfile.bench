# rune-crypto AEAD microbenchmark + latency gate, x86_64 (AES-NI) image.
#
# Build from the repo root:
#   docker build --platform=linux/amd64 -f docker/Dockerfile.bench -t rune-crypto-bench .
#
# The final RUN executes the benchmark itself, so `docker build` fails
# (non-zero exit) whenever the AES-256-GCM 4096B seal+open ns/op exceeds the
# gate. Calibrate the gate on the real box with, e.g.:
#   docker build --platform=linux/amd64 -f docker/Dockerfile.bench \
#     --build-arg RUNE_CRYPTO_BENCH_BUDGET_NS=3000 -t rune-crypto-bench .
FROM gcc:13

RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir --break-system-packages "conan~=2.0"

WORKDIR /app
COPY . .

RUN conan profile detect --force \
    && conan install . -s build_type=Release -s arch=x86_64 --build=missing

RUN cmake -B build \
        -DCMAKE_TOOLCHAIN_FILE=build/Release/generators/conan_toolchain.cmake \
        -DCMAKE_PREFIX_PATH=/app/build/Release/generators \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_BENCHMARKS=ON \
    && cmake --build build --target rune_crypto_bench -j

ARG RUNE_CRYPTO_BENCH_BUDGET_NS
ENV RUNE_CRYPTO_BENCH_BUDGET_NS=${RUNE_CRYPTO_BENCH_BUDGET_NS}

# Gate: fails the image build if seal+open ns/op exceeds the budget (default
# 5000ns when RUNE_CRYPTO_BENCH_BUDGET_NS is unset — see bench/AeadBench.cpp).
RUN ./build/rune_crypto_bench
